# Copy to .env for local development. Never commit .env.

# Postgres connection string.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/upland

# Set to "require" if your local Postgres needs TLS. Render is detected
# automatically and does not need this.
# PGSSL=require

PORT=3000
NODE_ENV=development

# Creates the first admin account when the users table is empty.
BOOTSTRAP_ADMIN_EMAIL=you@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-this-to-something-long
BOOTSTRAP_ADMIN_NAME=Your Name

# Load seed/systems.json and seed/links.json into an empty map.
SEED_ON_BOOT=true

# Endpoint poller.
MONITOR_ENABLED=true
MONITOR_SWEEP_MS=30000
MONITOR_TIMEOUT_MS=10000

SESSION_DAYS=14
