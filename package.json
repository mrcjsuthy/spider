{
  "name": "upland-systems-map",
  "version": "1.0.0",
  "private": true,
  "description": "Source of truth for every digital system in the Upland retirement village build.",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "seed": "node --env-file-if-exists=.env scripts/seed.js",
    "create-user": "node --env-file-if-exists=.env scripts/create-user.js",
    "monitor-worker": "node --env-file-if-exists=.env src/monitor-worker.js",
    "check": "for f in src/*.js scripts/*.js; do node --check \"$f\" || exit 1; done && echo ok"
  },
  "dependencies": {
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "ws": "^8.18.0"
  }
}
